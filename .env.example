# PostgreSQL / PostGIS
DATABASE_NAME=civicos
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/civicos
DATABASE_USERNAME=civicos
DATABASE_PASSWORD=replace-with-a-local-password
DATABASE_POOL_SIZE=10
DATABASE_MINIMUM_IDLE=2
DATABASE_CONNECTION_TIMEOUT_MS=30000

# Backend
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Authentication (replace the placeholder before starting the backend)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MINUTES=60
REFRESH_TOKEN_EXPIRATION_DAYS=14
JWT_ISSUER=civicos

# AI (implemented in Phase 11; disabled by default)
AI_ENABLED=false
AI_PROVIDER=mock
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=20

# File storage
FILE_STORAGE_PATH=./data/uploads
MAX_UPLOAD_SIZE=20MB

# Browser access
CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Feature flags
CITIZEN_REPORTING_ENABLED=true
DEMO_MODE=false

# Deterministic conflict policy (prototype defaults; externally configurable)
CONFLICT_PROXIMITY_METERS=0
CONFLICT_REPEAT_DIGGING_WINDOW_DAYS=30
CONFLICT_MULTI_AGENCY_MINIMUM=3
